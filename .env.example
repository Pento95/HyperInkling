# HyperInkling settings. `python3 scripts/wizard.py` writes .env for you; or copy this file
# to .env and edit. Every variable of start.sh works here. Numbers: RTX 3090 Ti, KV cache at
# 8 bits, 6 requests at once (docs/memory_matrix.tsv, README "Context and the knobs").

# --- Serving -------------------------------------------------------------------------
# Requests served at once (1-64). Fewer leave a little more room for the longest request.
MAX_SEQS=6
# Longest request, in tokens. With DSpark and the vision tower on the GPU, 262144 needs
# async scheduling off (ASYNC=auto does that); 213k fits with it on.
MAX_LEN=262144
# Port on the host (Docker publishes it); BIND=0.0.0.0 serves other machines, together
# with VLLM_API_KEY. Native start.sh: HOST=0.0.0.0 instead of BIND.
PORT=8080
BIND=127.0.0.1
# VLLM_API_KEY=

# --- Speed -----------------------------------------------------------------------------
# DSpark speculative decoding (lossless): 1.3-2.3x decode for one request, ~80k tokens of
# context. SPEC=off for the longest contexts.
SPEC=dspark
# Async scheduling: auto (off with DSpark above 192k), 1 or 0. Off: ~55k tokens more,
# -3 to -4% decode.
ASYNC=auto

# --- Images ----------------------------------------------------------------------------
# Images per request; 0 = no vision tower (~34k tokens more, text only).
IMAGES=50
# Vision tower weights in host RAM instead of on the GPU: ~34k tokens more, +27 ms per page.
HYPERINKLING_VISION_HOST=0
# Largest image (A4 at 150 ppi = 1,364 tokens); larger ones are scaled down to it.
IMAGE_MAX_W=1240
IMAGE_MAX_H=1760

# --- Memory ----------------------------------------------------------------------------
# Prefix cache tier in host RAM (/dev/shm), GiB; 0 = off. Docker: SHM_GB must exceed it.
KV_OFFLOAD_GB=auto
SHM_GB=48
# Fraction of the GPU memory vLLM takes; lower it by ~0.04 per GiB a display uses.
GPU_UTIL=0.95
