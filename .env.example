# HyperInkling settings. `python3 scripts/wizard.py` writes .env for you; or copy this file
# to .env and edit. Every variable of start.sh works here. Numbers: RTX 3090 Ti, KV cache at
# 8 bits, 8 requests at once (docs/memory_matrix.tsv, README "Context and the knobs").

# --- Serving -------------------------------------------------------------------------
# Requests served at once (1-64). Fewer leave a little more room for the longest request.
MAX_SEQS=8
# Longest request, in tokens: auto = what the GPU holds (268k with these settings); a number
# caps it, and the boot fails if it does not fit.
MAX_LEN=auto
# Port on the host (Docker publishes it); BIND=0.0.0.0 serves other machines, together
# with VLLM_API_KEY. Native start.sh: HOST=0.0.0.0 instead of BIND.
PORT=8080
BIND=127.0.0.1
# VLLM_API_KEY=

# --- Speed -----------------------------------------------------------------------------
# DSpark speculative decoding (lossless): 1.5-2x decode for one request, ~78k tokens of
# context. SPEC=off for the longest contexts.
SPEC=dspark
# Async scheduling, 1 or 0. Off: ~17k tokens more, -3 to -4% decode.
ASYNC=1
# Most tokens of one prompt per step while other requests are there; 0 = no limit.
# Empty: half of NBT.
LONG_PREFILL=

# --- Images ----------------------------------------------------------------------------
# Images per request; 0 = no vision tower (~37k tokens more, text only).
IMAGES=50
# Vision tower weights in host RAM instead of on the GPU: ~36k tokens more, +27 ms per page.
HYPERINKLING_VISION_HOST=0
# Largest image (1,014 tokens, A4 at ~126 ppi); larger ones are scaled down to it.
IMAGE_MAX_W=1040
IMAGE_MAX_H=1560

# --- Memory ----------------------------------------------------------------------------
# Prefix cache tier in host RAM (/dev/shm), GiB; 0 = off. Docker: SHM_GB must exceed it.
KV_OFFLOAD_GB=auto
SHM_GB=48
# Fraction of the GPU memory vLLM takes; lower it by ~0.04 per GiB a display uses.
GPU_UTIL=0.95
