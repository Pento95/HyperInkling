diff --git a/vllm/models/inkling2/nvidia/ops/linear_w4.py b/vllm/models/inkling2/nvidia/ops/linear_w4.py
new file mode 100644
index 0000000000..884f759994
--- /dev/null
+++ b/vllm/models/inkling2/nvidia/ops/linear_w4.py
@@ -0,0 +1,210 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""HyperInkling W4A16 linears: bf16 weights quantized at load time to int4
+(asymmetric round-to-nearest, one bf16 scale and one zero point per 128
+inputs of each output channel), run by a Triton kernel derived from
+`linear_w8`'s.
+
+Codes are packed two per byte along K (`[N, K / 2]` uint8, even k in the
+low nibble), so rows stay contiguous and slicing rows is free, as for
+W8Linear. The kernel does not interleave the nibbles: it multiplies the low
+nibbles by the even input columns and the high nibbles by the odd ones.
+
+For weights whose error only costs speed, not output (the DSpark drafter:
+the target verifies every draft), round-to-nearest needs no calibration.
+"""
+
+import torch
+
+from vllm.triton_utils import tl, triton
+
+GROUP = 128
+# Decode (m <= 64) split-K launch shape, tuned on an RTX 3090 Ti.
+W4_DECODE_BN = 128
+W4_DECODE_WARPS = 4
+W4_DECODE_STAGES = 2
+W4_PROGRAMS_PER_SM = 2
+# Decode outputs at least this wide take the single-launch kernel.
+W4_WIDE_N = 16384
+
+
+def quantize_int4(weight: torch.Tensor):
+    """bf16 `[N, K]` -> packed codes `[N, K / 2]` uint8, bf16 scales and
+    uint8 zero points `[N, K / GROUP]`."""
+    g = weight.float().unflatten(1, (-1, GROUP))
+    lo, hi = g.amin(-1), g.amax(-1)
+    scale = ((hi - lo) / 15.0).clamp_min(1e-10).to(torch.bfloat16)
+    s = scale.float()
+    zero = (-lo / s).round().clamp(0, 15)
+    q = ((g / s[..., None]).round() + zero[..., None]).clamp(0, 15).to(torch.uint8)
+    q = q.flatten(1)
+    packed = q[:, 0::2] | (q[:, 1::2] << 4)
+    return packed.contiguous(), scale, zero.to(torch.uint8)
+
+
+def dequantize_int4(
+    packed: torch.Tensor, scale: torch.Tensor, zero: torch.Tensor
+) -> torch.Tensor:
+    q = torch.stack([packed & 15, packed >> 4], dim=-1).flatten(1).float()
+    g = q.unflatten(1, (-1, GROUP)) - zero.float()[..., None]
+    return (g * scale.float()[..., None]).flatten(1)
+
+
+@triton.jit
+def _w4_kernel(
+    X, W, S, Z, Y, M, N, K, SX, SW, SS, SZ, SY,
+    BM: tl.constexpr, BN: tl.constexpr, G: tl.constexpr,
+):  # fmt: skip
+    pid_n = tl.program_id(0)
+    pid_m = tl.program_id(1)
+    rows = pid_m * BM + tl.arange(0, BM)
+    cols = pid_n * BN + tl.arange(0, BN)
+    col_ok = cols < N
+    row_ok = rows[:, None] < M
+    half = tl.arange(0, G // 2)
+    acc = tl.zeros((BM, BN), tl.float32)
+    for g in range(0, tl.cdiv(K, G)):
+        b = tl.load(
+            W + cols[None, :].to(tl.int64) * SW + (g * (G // 2) + half)[:, None],
+            col_ok[None, :],
+            other=0,
+        )
+        z = tl.load(Z + cols.to(tl.int64) * SZ + g, col_ok, other=0).to(tl.float32)
+        s = tl.load(S + cols.to(tl.int64) * SS + g, col_ok, other=0).to(tl.float32)
+        lo = ((b & 15).to(tl.float32) - z[None, :]).to(tl.bfloat16)
+        hi = ((b >> 4).to(tl.float32) - z[None, :]).to(tl.bfloat16)
+        xk = rows[:, None].to(tl.int64) * SX + g * G + 2 * half[None, :]
+        x_even = tl.load(X + xk, row_ok, other=0)
+        x_odd = tl.load(X + xk + 1, row_ok, other=0)
+        part = tl.dot(x_even, lo)
+        part = tl.dot(x_odd, hi, part)
+        acc += part * s[None, :]
+    tl.store(
+        Y + rows[:, None].to(tl.int64) * SY + cols[None, :],
+        acc.to(Y.dtype.element_ty),
+        row_ok & col_ok[None, :],
+    )
+
+
+@triton.jit
+def _w4_splitk_kernel(
+    X, W, S, Z, Y, M, N, K, SX, SW, SS, SZ, SY, GROUPS_PER_SPLIT,
+    BM: tl.constexpr, BN: tl.constexpr, G: tl.constexpr,
+):  # fmt: skip
+    # Decode: all rows in one tile, each program one column tile and one K
+    # range, fp32 partials added into Y. Weights load as [BN, G / 2] (K
+    # contiguous) and the activations as [BM, G], split into even/odd columns.
+    pid_n = tl.program_id(0)
+    pid_k = tl.program_id(1)
+    rows = tl.arange(0, BM)
+    cols = pid_n * BN + tl.arange(0, BN)
+    col_ok = cols < N
+    row_ok = rows[:, None] < M
+    half = tl.arange(0, G // 2)
+    ks = tl.arange(0, G)
+    acc = tl.zeros((BM, BN), tl.float32)
+    g0 = pid_k * GROUPS_PER_SPLIT
+    g1 = tl.minimum(g0 + GROUPS_PER_SPLIT, tl.cdiv(K, G))
+    for g in range(g0, g1):
+        b = tl.load(
+            W + cols[:, None].to(tl.int64) * SW + (g * (G // 2) + half)[None, :],
+            col_ok[:, None],
+            other=0,
+        )
+        z = tl.load(Z + cols.to(tl.int64) * SZ + g, col_ok, other=0).to(tl.float32)
+        s = tl.load(S + cols.to(tl.int64) * SS + g, col_ok, other=0).to(tl.float32)
+        lo = ((b & 15).to(tl.float32) - z[:, None]).to(tl.bfloat16)
+        hi = ((b >> 4).to(tl.float32) - z[:, None]).to(tl.bfloat16)
+        x = tl.load(
+            X + rows[:, None].to(tl.int64) * SX + g * G + ks[None, :], row_ok, other=0
+        )
+        x_even, x_odd = tl.split(tl.reshape(x, (BM, G // 2, 2)))
+        part = tl.dot(x_even, tl.trans(lo))
+        part = tl.dot(x_odd, tl.trans(hi), part)
+        acc += part * s[None, :]
+    tl.atomic_add(
+        Y + rows[:, None].to(tl.int64) * SY + cols[None, :],
+        acc,
+        row_ok & col_ok[None, :],
+        sem="relaxed",
+    )
+
+
+_NUM_SMS: int | None = None
+
+
+def _num_sms(device: torch.device) -> int:
+    global _NUM_SMS
+    if _NUM_SMS is None:
+        _NUM_SMS = torch.cuda.get_device_properties(device).multi_processor_count
+    return _NUM_SMS
+
+
+def w4_matmul(
+    x: torch.Tensor,
+    packed: torch.Tensor,
+    scale: torch.Tensor,
+    zero: torch.Tensor,
+    out: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """`x [M, K] bf16 @ dequant(packed, scale, zero).T` -> `[M, N]` bf16."""
+    m, k = x.shape
+    n = packed.shape[0]
+    assert k % GROUP == 0 and packed.shape[1] * 2 == k and x.stride(1) == 1
+    if out is None:
+        out = torch.empty((m, n), dtype=x.dtype, device=x.device)
+    if m == 0:
+        return out
+    if m <= 64 and n >= W4_WIDE_N:
+        # Wide outputs (the Markov fold, the drafter's gate_up) fill every SM without
+        # splitting K: one launch, no fp32 partials (bench/w4_gemv.py, RTX 3090 Ti:
+        # fold 786 vs 660 GB/s at 1 row, 679 vs 431 at 7; gate_up 724 vs 554 at 1 row).
+        bm = max(16, triton.next_power_of_2(m))
+        bn = 128 if m == 1 else 64
+        wide_k = k > 1024
+        _w4_kernel[(triton.cdiv(n, bn), 1)](
+            x, packed, scale, zero, out, m, n, k,
+            x.stride(0), packed.stride(0), scale.stride(0), zero.stride(0),
+            out.stride(0), BM=bm, BN=bn, G=GROUP,
+            num_warps=8 if wide_k else 4, num_stages=3 if wide_k else 2,
+        )  # fmt: skip
+        return out
+    if m <= 64:
+        bm = max(16, triton.next_power_of_2(m))
+        bn = W4_DECODE_BN
+        groups = k // GROUP
+        tiles = triton.cdiv(n, bn)
+        programs = W4_PROGRAMS_PER_SM * _num_sms(x.device)
+        splits = min(groups, triton.cdiv(programs, tiles))
+        per_split = triton.cdiv(groups, splits)
+        splits = triton.cdiv(groups, per_split)
+        acc = torch.zeros((m, n), dtype=torch.float32, device=x.device)
+        _w4_splitk_kernel[(tiles, splits)](
+            x, packed, scale, zero, acc, m, n, k,
+            x.stride(0), packed.stride(0), scale.stride(0), zero.stride(0),
+            acc.stride(0), per_split, BM=bm, BN=bn, G=GROUP,
+            num_warps=W4_DECODE_WARPS, num_stages=W4_DECODE_STAGES,
+        )  # fmt: skip
+        out.copy_(acc)
+        return out
+    bm, bn, warps, stages = 64, 128, 8, 3
+    grid = (triton.cdiv(n, bn), triton.cdiv(m, bm))
+    _w4_kernel[grid](
+        x, packed, scale, zero, out, m, n, k,
+        x.stride(0), packed.stride(0), scale.stride(0), zero.stride(0), out.stride(0),
+        BM=bm, BN=bn, G=GROUP, num_warps=warps, num_stages=stages,
+    )  # fmt: skip
+    return out
+
+
+class W4Linear:
+    """`x @ weight.T` for a bf16 `weight [N, K]`, as int4 W4A16."""
+
+    def __init__(self, weight: torch.Tensor) -> None:
+        self.size_n, self.size_k = weight.shape
+        self.packed, self.scale, self.zero = quantize_int4(weight)
+
+    def __call__(
+        self, x: torch.Tensor, out: torch.Tensor | None = None
+    ) -> torch.Tensor:
+        return w4_matmul(x.contiguous(), self.packed, self.scale, self.zero, out)
diff --git a/vllm/models/inkling2/nvidia/ops/linear_w8.py b/vllm/models/inkling2/nvidia/ops/linear_w8.py
new file mode 100644
index 0000000000..2da3cb057a
--- /dev/null
+++ b/vllm/models/inkling2/nvidia/ops/linear_w8.py
@@ -0,0 +1,139 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""HyperInkling W8A16 linears: bf16 weights quantized at load time to int8
+(symmetric, one bf16 scale per 128 inputs of each output channel), run by
+a Triton GEMV/GEMM kernel.
+
+The weight keeps the natural `[N, K]` layout, so slicing rows stays free
+and full layers can project q, k and v (different inputs) in one launch:
+`W8Linear.multi` stacks the inputs, reads the weight once and returns each
+input's column range. Decode is bandwidth bound, so the extra rows cost
+little. Prefill (many rows) runs the same kernel with larger row tiles.
+
+Group-128 int8 round-to-nearest needs no calibration and works on the
+released checkpoint as is.
+"""
+
+import torch
+
+from vllm.triton_utils import tl, triton
+
+GROUP = 128
+
+
+def quantize_int8(weight: torch.Tensor):
+    """bf16 `[N, K]` -> int8 codes `[N, K]` and bf16 scales `[N, K / GROUP]`."""
+    g = weight.float().unflatten(1, (-1, GROUP))
+    scale = (g.abs().amax(-1) / 127.0).clamp_min(1e-10).to(torch.bfloat16)
+    q = (g / scale.float()[..., None]).round().clamp(-127, 127)
+    return q.flatten(1).to(torch.int8), scale
+
+
+def dequantize_int8(q: torch.Tensor, scale: torch.Tensor) -> torch.Tensor:
+    return (q.float().unflatten(1, (-1, GROUP)) * scale.float()[..., None]).flatten(1)
+
+
+@triton.jit
+def _w8_kernel(
+    X, W, S, Y, M, N, K, SX, SW, SS, SY,
+    BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,
+):  # fmt: skip
+    pid_n = tl.program_id(0)
+    pid_m = tl.program_id(1)
+    rows = pid_m * BM + tl.arange(0, BM)
+    cols = pid_n * BN + tl.arange(0, BN)
+    col_ok = cols < N
+    acc = tl.zeros((BM, BN), tl.float32)
+    for g in range(0, tl.cdiv(K, BK)):
+        ks = g * BK + tl.arange(0, BK)
+        w = tl.load(
+            W + cols[None, :].to(tl.int64) * SW + ks[:, None],
+            col_ok[None, :],
+            other=0,
+        )
+        x = tl.load(
+            X + rows[:, None].to(tl.int64) * SX + ks[None, :],
+            rows[:, None] < M,
+            other=0,
+        )
+        s = tl.load(S + cols.to(tl.int64) * SS + g, col_ok, other=0).to(tl.float32)
+        acc += tl.dot(x, w.to(tl.bfloat16)) * s[None, :]
+    tl.store(
+        Y + rows[:, None].to(tl.int64) * SY + cols[None, :],
+        acc.to(Y.dtype.element_ty),
+        (rows[:, None] < M) & col_ok[None, :],
+    )
+
+
+def w8_matmul(
+    x: torch.Tensor,
+    q: torch.Tensor,
+    scale: torch.Tensor,
+    out: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """`x [M, K] bf16 @ dequant(q, scale).T` -> `[M, N]` bf16."""
+    m, k = x.shape
+    n = q.shape[0]
+    assert k % GROUP == 0 and q.shape[1] == k and x.stride(1) == 1
+    if out is None:
+        out = torch.empty((m, n), dtype=x.dtype, device=x.device)
+    if m == 0:
+        return out
+    # Tiles tuned on an RTX 3090 Ti (L2-cold weights, bench/w8_gemv.py;
+    # tests/test_linear_w8.py covers every branch). Decode: one row tile, column
+    # tiles narrow enough to spread the weight over every SM. Verify steps
+    # (requests x (1 + drafts): 3-128 rows) have their own tiles; above 128 rows,
+    # the prefill tile. Four widths: k/v (<= 1024), o (< 4096), qkvr and the
+    # query side (< 32768), the LM head.
+    size = 0 if n <= 1024 else 1 if n < 4096 else 2 if n < 32768 else 3
+    if m == 1:
+        tiles = ((16, 16, 2, 4), (16, 16, 2, 4), (16, 32, 4, 3), (16, 128, 8, 5))
+    elif m <= 12:
+        tiles = ((16, 32, 4, 4), (16, 32, 4, 4), (16, 32, 4, 3), (16, 128, 8, 5))
+    elif m <= 32:
+        tiles = ((16, 32, 4, 3), (16, 64, 8, 3), (32, 128, 8, 3), (32, 64, 4, 2))
+    elif m <= 64:
+        tiles = ((32, 32, 8, 3), (32, 64, 4, 3), (32, 128, 4, 3), (64, 128, 4, 2))
+    elif m <= 128:
+        tiles = ((32, 64, 4, 3), (32, 128, 8, 3), (64, 256, 8, 3), (128, 128, 8, 2))
+    else:
+        tiles = ((64, 256, 8, 3),) * 4
+    bm, bn, warps, stages = tiles[size]
+    grid = (triton.cdiv(n, bn), triton.cdiv(m, bm))
+    _w8_kernel[grid](
+        x, q, scale, out, m, n, k,
+        x.stride(0), q.stride(0), scale.stride(0), out.stride(0),
+        BM=bm, BN=bn, BK=GROUP, num_warps=warps, num_stages=stages,
+    )  # fmt: skip
+    return out
+
+
+class W8Linear:
+    """`x @ weight.T` for a bf16 `weight [N, K]`, as int8 W8A16."""
+
+    def __init__(self, weight: torch.Tensor) -> None:
+        self.size_n, self.size_k = weight.shape
+        self.q, self.scale = quantize_int8(weight)
+
+    def __call__(
+        self, x: torch.Tensor, out: torch.Tensor | None = None
+    ) -> torch.Tensor:
+        return w8_matmul(x.contiguous(), self.q, self.scale, out)
+
+    def multi(
+        self, inputs: list[torch.Tensor], col_ranges: list[tuple[int, int]]
+    ) -> list[torch.Tensor]:
+        """`inputs[i] @ weight[col_ranges[i]].T` for each i, reading the weight
+        once when the stacked rows fit one decode tile, else one launch each."""
+        rows = [x.shape[0] for x in inputs]
+        if sum(rows) <= 32:
+            y = w8_matmul(torch.cat(inputs), self.q, self.scale)
+            out, start = [], 0
+            for r, (lo, hi) in zip(rows, col_ranges):
+                out.append(y[start : start + r, lo:hi])
+                start += r
+            return out
+        return [
+            w8_matmul(x.contiguous(), self.q[lo:hi], self.scale[lo:hi])
+            for x, (lo, hi) in zip(inputs, col_ranges)
+        ]
