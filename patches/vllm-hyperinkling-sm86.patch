diff --git a/vllm/models/inkling2/nvidia/ops/linear_w4.py b/vllm/models/inkling2/nvidia/ops/linear_w4.py
new file mode 100644
index 000000000..05a061769
--- /dev/null
+++ b/vllm/models/inkling2/nvidia/ops/linear_w4.py
@@ -0,0 +1,194 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""HyperInkling W4A16 linears: bf16 weights quantized at load time to int4
+(asymmetric round-to-nearest, one bf16 scale and one zero point per 128
+inputs of each output channel), run by a Triton kernel derived from
+`linear_w8`'s.
+
+Codes are packed two per byte along K (`[N, K / 2]` uint8, even k in the
+low nibble), so rows stay contiguous and slicing rows is free, as for
+W8Linear. The kernel does not interleave the nibbles: it multiplies the low
+nibbles by the even input columns and the high nibbles by the odd ones.
+
+For weights whose error only costs speed, not output (the DSpark drafter:
+the target verifies every draft), round-to-nearest needs no calibration.
+"""
+
+import torch
+
+from vllm.triton_utils import tl, triton
+
+GROUP = 128
+# Decode (m <= 64) split-K launch shape, tuned on an RTX 3090 Ti.
+W4_DECODE_BN = 128
+W4_DECODE_WARPS = 4
+W4_DECODE_STAGES = 2
+W4_PROGRAMS_PER_SM = 2
+
+
+def quantize_int4(weight: torch.Tensor):
+    """bf16 `[N, K]` -> packed codes `[N, K / 2]` uint8, bf16 scales and
+    uint8 zero points `[N, K / GROUP]`."""
+    g = weight.float().unflatten(1, (-1, GROUP))
+    lo, hi = g.amin(-1), g.amax(-1)
+    scale = ((hi - lo) / 15.0).clamp_min(1e-10).to(torch.bfloat16)
+    s = scale.float()
+    zero = (-lo / s).round().clamp(0, 15)
+    q = ((g / s[..., None]).round() + zero[..., None]).clamp(0, 15).to(torch.uint8)
+    q = q.flatten(1)
+    packed = q[:, 0::2] | (q[:, 1::2] << 4)
+    return packed.contiguous(), scale, zero.to(torch.uint8)
+
+
+def dequantize_int4(
+    packed: torch.Tensor, scale: torch.Tensor, zero: torch.Tensor
+) -> torch.Tensor:
+    q = torch.stack([packed & 15, packed >> 4], dim=-1).flatten(1).float()
+    g = q.unflatten(1, (-1, GROUP)) - zero.float()[..., None]
+    return (g * scale.float()[..., None]).flatten(1)
+
+
+@triton.jit
+def _w4_kernel(
+    X, W, S, Z, Y, M, N, K, SX, SW, SS, SZ, SY,
+    BM: tl.constexpr, BN: tl.constexpr, G: tl.constexpr,
+):  # fmt: skip
+    pid_n = tl.program_id(0)
+    pid_m = tl.program_id(1)
+    rows = pid_m * BM + tl.arange(0, BM)
+    cols = pid_n * BN + tl.arange(0, BN)
+    col_ok = cols < N
+    row_ok = rows[:, None] < M
+    half = tl.arange(0, G // 2)
+    acc = tl.zeros((BM, BN), tl.float32)
+    for g in range(0, tl.cdiv(K, G)):
+        b = tl.load(
+            W + cols[None, :].to(tl.int64) * SW + (g * (G // 2) + half)[:, None],
+            col_ok[None, :],
+            other=0,
+        )
+        z = tl.load(Z + cols.to(tl.int64) * SZ + g, col_ok, other=0).to(tl.float32)
+        s = tl.load(S + cols.to(tl.int64) * SS + g, col_ok, other=0).to(tl.float32)
+        lo = ((b & 15).to(tl.float32) - z[None, :]).to(tl.bfloat16)
+        hi = ((b >> 4).to(tl.float32) - z[None, :]).to(tl.bfloat16)
+        xk = rows[:, None].to(tl.int64) * SX + g * G + 2 * half[None, :]
+        x_even = tl.load(X + xk, row_ok, other=0)
+        x_odd = tl.load(X + xk + 1, row_ok, other=0)
+        part = tl.dot(x_even, lo)
+        part = tl.dot(x_odd, hi, part)
+        acc += part * s[None, :]
+    tl.store(
+        Y + rows[:, None].to(tl.int64) * SY + cols[None, :],
+        acc.to(Y.dtype.element_ty),
+        row_ok & col_ok[None, :],
+    )
+
+
+@triton.jit
+def _w4_splitk_kernel(
+    X, W, S, Z, Y, M, N, K, SX, SW, SS, SZ, SY, GROUPS_PER_SPLIT,
+    BM: tl.constexpr, BN: tl.constexpr, G: tl.constexpr,
+):  # fmt: skip
+    # Decode: all rows in one tile, each program one column tile and one K
+    # range, fp32 partials added into Y. Weights load as [BN, G / 2] (K
+    # contiguous) and the activations as [BM, G], split into even/odd columns.
+    pid_n = tl.program_id(0)
+    pid_k = tl.program_id(1)
+    rows = tl.arange(0, BM)
+    cols = pid_n * BN + tl.arange(0, BN)
+    col_ok = cols < N
+    row_ok = rows[:, None] < M
+    half = tl.arange(0, G // 2)
+    ks = tl.arange(0, G)
+    acc = tl.zeros((BM, BN), tl.float32)
+    g0 = pid_k * GROUPS_PER_SPLIT
+    g1 = tl.minimum(g0 + GROUPS_PER_SPLIT, tl.cdiv(K, G))
+    for g in range(g0, g1):
+        b = tl.load(
+            W + cols[:, None].to(tl.int64) * SW + (g * (G // 2) + half)[None, :],
+            col_ok[:, None],
+            other=0,
+        )
+        z = tl.load(Z + cols.to(tl.int64) * SZ + g, col_ok, other=0).to(tl.float32)
+        s = tl.load(S + cols.to(tl.int64) * SS + g, col_ok, other=0).to(tl.float32)
+        lo = ((b & 15).to(tl.float32) - z[:, None]).to(tl.bfloat16)
+        hi = ((b >> 4).to(tl.float32) - z[:, None]).to(tl.bfloat16)
+        x = tl.load(
+            X + rows[:, None].to(tl.int64) * SX + g * G + ks[None, :], row_ok, other=0
+        )
+        x_even, x_odd = tl.split(tl.reshape(x, (BM, G // 2, 2)))
+        part = tl.dot(x_even, tl.trans(lo))
+        part = tl.dot(x_odd, tl.trans(hi), part)
+        acc += part * s[None, :]
+    tl.atomic_add(
+        Y + rows[:, None].to(tl.int64) * SY + cols[None, :],
+        acc,
+        row_ok & col_ok[None, :],
+        sem="relaxed",
+    )
+
+
+_NUM_SMS: int | None = None
+
+
+def _num_sms(device: torch.device) -> int:
+    global _NUM_SMS
+    if _NUM_SMS is None:
+        _NUM_SMS = torch.cuda.get_device_properties(device).multi_processor_count
+    return _NUM_SMS
+
+
+def w4_matmul(
+    x: torch.Tensor,
+    packed: torch.Tensor,
+    scale: torch.Tensor,
+    zero: torch.Tensor,
+    out: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """`x [M, K] bf16 @ dequant(packed, scale, zero).T` -> `[M, N]` bf16."""
+    m, k = x.shape
+    n = packed.shape[0]
+    assert k % GROUP == 0 and packed.shape[1] * 2 == k and x.stride(1) == 1
+    if out is None:
+        out = torch.empty((m, n), dtype=x.dtype, device=x.device)
+    if m == 0:
+        return out
+    if m <= 64:
+        bm = max(16, triton.next_power_of_2(m))
+        bn = W4_DECODE_BN
+        groups = k // GROUP
+        tiles = triton.cdiv(n, bn)
+        programs = W4_PROGRAMS_PER_SM * _num_sms(x.device)
+        splits = min(groups, triton.cdiv(programs, tiles))
+        per_split = triton.cdiv(groups, splits)
+        splits = triton.cdiv(groups, per_split)
+        acc = torch.zeros((m, n), dtype=torch.float32, device=x.device)
+        _w4_splitk_kernel[(tiles, splits)](
+            x, packed, scale, zero, acc, m, n, k,
+            x.stride(0), packed.stride(0), scale.stride(0), zero.stride(0),
+            acc.stride(0), per_split, BM=bm, BN=bn, G=GROUP,
+            num_warps=W4_DECODE_WARPS, num_stages=W4_DECODE_STAGES,
+        )  # fmt: skip
+        out.copy_(acc)
+        return out
+    bm, bn, warps, stages = 64, 128, 8, 3
+    grid = (triton.cdiv(n, bn), triton.cdiv(m, bm))
+    _w4_kernel[grid](
+        x, packed, scale, zero, out, m, n, k,
+        x.stride(0), packed.stride(0), scale.stride(0), zero.stride(0), out.stride(0),
+        BM=bm, BN=bn, G=GROUP, num_warps=warps, num_stages=stages,
+    )  # fmt: skip
+    return out
+
+
+class W4Linear:
+    """`x @ weight.T` for a bf16 `weight [N, K]`, as int4 W4A16."""
+
+    def __init__(self, weight: torch.Tensor) -> None:
+        self.size_n, self.size_k = weight.shape
+        self.packed, self.scale, self.zero = quantize_int4(weight)
+
+    def __call__(
+        self, x: torch.Tensor, out: torch.Tensor | None = None
+    ) -> torch.Tensor:
+        return w4_matmul(x.contiguous(), self.packed, self.scale, self.zero, out)
diff --git a/vllm/models/inkling2/nvidia/ops/linear_w8.py b/vllm/models/inkling2/nvidia/ops/linear_w8.py
new file mode 100644
index 000000000..93a740e96
--- /dev/null
+++ b/vllm/models/inkling2/nvidia/ops/linear_w8.py
@@ -0,0 +1,132 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""HyperInkling W8A16 linears: bf16 weights quantized at load time to int8
+(symmetric, one bf16 scale per 128 inputs of each output channel), run by
+a Triton kernel derived from `ops.gemv`'s.
+
+The weight keeps the natural `[N, K]` layout, so slicing rows stays free
+and full layers can project q, k and v (different inputs) in one launch:
+`W8Linear.multi` stacks the inputs, reads the weight once and returns each
+input's column range. Decode is bandwidth bound, so the extra rows cost
+little. Prefill (many rows) runs the same kernel with larger row tiles.
+
+Group-128 int8 round-to-nearest needs no calibration and works on the
+released checkpoint as is.
+"""
+
+import torch
+
+from vllm.triton_utils import tl, triton
+
+GROUP = 128
+
+
+def quantize_int8(weight: torch.Tensor):
+    """bf16 `[N, K]` -> int8 codes `[N, K]` and bf16 scales `[N, K / GROUP]`."""
+    g = weight.float().unflatten(1, (-1, GROUP))
+    scale = (g.abs().amax(-1) / 127.0).clamp_min(1e-10).to(torch.bfloat16)
+    q = (g / scale.float()[..., None]).round().clamp(-127, 127)
+    return q.flatten(1).to(torch.int8), scale
+
+
+def dequantize_int8(q: torch.Tensor, scale: torch.Tensor) -> torch.Tensor:
+    return (q.float().unflatten(1, (-1, GROUP)) * scale.float()[..., None]).flatten(1)
+
+
+@triton.jit
+def _w8_kernel(
+    X, W, S, Y, M, N, K, SX, SW, SS, SY,
+    BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,
+):  # fmt: skip
+    pid_n = tl.program_id(0)
+    pid_m = tl.program_id(1)
+    rows = pid_m * BM + tl.arange(0, BM)
+    cols = pid_n * BN + tl.arange(0, BN)
+    col_ok = cols < N
+    acc = tl.zeros((BM, BN), tl.float32)
+    for g in range(0, tl.cdiv(K, BK)):
+        ks = g * BK + tl.arange(0, BK)
+        w = tl.load(
+            W + cols[None, :].to(tl.int64) * SW + ks[:, None],
+            col_ok[None, :],
+            other=0,
+        )
+        x = tl.load(
+            X + rows[:, None].to(tl.int64) * SX + ks[None, :],
+            rows[:, None] < M,
+            other=0,
+        )
+        s = tl.load(S + cols.to(tl.int64) * SS + g, col_ok, other=0).to(tl.float32)
+        acc += tl.dot(x, w.to(tl.bfloat16)) * s[None, :]
+    tl.store(
+        Y + rows[:, None].to(tl.int64) * SY + cols[None, :],
+        acc.to(Y.dtype.element_ty),
+        (rows[:, None] < M) & col_ok[None, :],
+    )
+
+
+def w8_matmul(
+    x: torch.Tensor, q: torch.Tensor, scale: torch.Tensor, out: torch.Tensor | None = None
+) -> torch.Tensor:
+    """`x [M, K] bf16 @ dequant(q, scale).T` -> `[M, N]` bf16."""
+    m, k = x.shape
+    n = q.shape[0]
+    assert k % GROUP == 0 and q.shape[1] == k and x.stride(1) == 1
+    if out is None:
+        out = torch.empty((m, n), dtype=x.dtype, device=x.device)
+    if m == 0:
+        return out
+    # Tiles tuned on an RTX 3090 Ti (L2-cold weights; tests/test_linear_w8.py
+    # covers every branch). Decode: one row tile, column tiles narrow enough
+    # to spread the weight over every SM.
+    # Verify steps (2-64 rows: requests x (1 + drafts)) have their own tiles:
+    # the prefill tile at 48 rows ran `wo` at 84 GB/s instead of 334.
+    wide = n >= 4096
+    if m == 1:
+        bm, bn, warps, stages = (16, 32, 4, 3) if wide else (16, 16, 2, 4)
+    elif m <= 16:
+        bm, bn, warps, stages = (16, 128, 8, 3) if wide else (16, 32, 4, 4)
+    elif m <= 32:
+        bm, bn, warps, stages = (32, 128, 8, 3) if wide else (32, 32, 8, 3)
+    elif m <= 64:
+        bm, bn, warps, stages = (64, 128, 8, 3) if wide else (64, 32, 4, 4)
+    else:
+        bm, bn, warps, stages = 64, 256, 8, 3
+    grid = (triton.cdiv(n, bn), triton.cdiv(m, bm))
+    _w8_kernel[grid](
+        x, q, scale, out, m, n, k,
+        x.stride(0), q.stride(0), scale.stride(0), out.stride(0),
+        BM=bm, BN=bn, BK=GROUP, num_warps=warps, num_stages=stages,
+    )  # fmt: skip
+    return out
+
+
+class W8Linear:
+    """`x @ weight.T` for a bf16 `weight [N, K]`, as int8 W8A16."""
+
+    def __init__(self, weight: torch.Tensor) -> None:
+        self.size_n, self.size_k = weight.shape
+        self.q, self.scale = quantize_int8(weight)
+
+    def __call__(
+        self, x: torch.Tensor, out: torch.Tensor | None = None
+    ) -> torch.Tensor:
+        return w8_matmul(x.contiguous(), self.q, self.scale, out)
+
+    def multi(
+        self, inputs: list[torch.Tensor], col_ranges: list[tuple[int, int]]
+    ) -> list[torch.Tensor]:
+        """`inputs[i] @ weight[col_ranges[i]].T` for each i, reading the weight
+        once when the stacked rows fit one decode tile, else one launch each."""
+        rows = [x.shape[0] for x in inputs]
+        if sum(rows) <= 32:
+            y = w8_matmul(torch.cat(inputs), self.q, self.scale)
+            out, start = [], 0
+            for r, (lo, hi) in zip(rows, col_ranges):
+                out.append(y[start : start + r, lo:hi])
+                start += r
+            return out
+        return [
+            w8_matmul(x.contiguous(), self.q[lo:hi], self.scale[lo:hi])
+            for x, (lo, hi) in zip(inputs, col_ranges)
+        ]
diff --git a/vllm/models/inkling2/nvidia/ops/lookup.py b/vllm/models/inkling2/nvidia/ops/lookup.py
new file mode 100644
index 000000000..7adad6c9b
--- /dev/null
+++ b/vllm/models/inkling2/nvidia/ops/lookup.py
@@ -0,0 +1,178 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Drafting from the request's own context (HYPERINKLING_LOOKUP=1).
+
+The DSpark drafter sees a 1024-token window; a document the answer quotes can be far
+beyond it. One Triton program per request finds the most recent occurrence of the longest
+suffix (NMIN..NMAX tokens) of the token history and proposes the tokens that followed it.
+The proposal is fused with the drafter's: a match of `nstrong` tokens or more replaces the
+drafts on its own, a shorter one (down to `nmin`) only where the drafter independently
+proposed the same first `agree_min` tokens.
+
+Lossless: every position taken from the lookup gets a point mass on the proposed token in
+the draft-logits cache, a legal q for the rejection sampler (acceptance becomes p(x)).
+
+After HyperQwen's dflash2-lookup-drafting (syv-ai/HyperQwen, Apache-2.0).
+"""
+
+import torch
+
+from vllm.triton_utils import tl, triton
+
+# "Longest match, then most recent" as one max over len * SCORE_STRIDE + end index.
+SCORE_STRIDE = tl.constexpr(1 << 32)
+
+
+@triton.jit
+def _suffix_lookup_kernel(
+    tokens_ptr,
+    tokens_stride,
+    total_len_ptr,
+    idx_mapping_ptr,
+    idx_mapping_stride,
+    out_tokens_ptr,
+    out_len_ptr,
+    out_valid_ptr,
+    search_max,
+    K: tl.constexpr,
+    NMAX: tl.constexpr,
+    NMIN: tl.constexpr,
+    BLOCK: tl.constexpr,
+    BLOCK_K: tl.constexpr,
+):
+    req = tl.program_id(0)
+    tl.store(out_len_ptr + req, 0)
+    tl.store(out_valid_ptr + req, 0)
+    req_state = tl.load(idx_mapping_ptr + req * idx_mapping_stride)
+    if req_state < 0:
+        return
+    total_len = tl.load(total_len_ptr + req_state)
+    if total_len < NMIN + 2:
+        return
+    base = tokens_ptr + req_state.to(tl.int64) * tokens_stride
+    end_of_suffix = total_len - 1
+    # Candidate ends before the suffix's own end; a candidate may overlap the suffix, so
+    # a repeating pattern (a list marker, an indent) is proposed from its own period.
+    hi = end_of_suffix
+    lo = tl.maximum(NMIN - 1, total_len - search_max)
+    best = tl.full([], -1, tl.int64)
+    for start in range(lo, hi, BLOCK):
+        e = start + tl.arange(0, BLOCK)
+        alive = (e < hi) & (e >= lo)
+        # The NMIN-token prefix first: most blocks die here.
+        for j in range(NMIN):
+            s_j = tl.load(base + end_of_suffix - j)
+            t_j = tl.load(base + e - j, mask=alive & ((e - j) >= 0), other=-1)
+            alive = alive & (t_j == s_j)
+        if tl.max(alive.to(tl.int32)) > 0:
+            match = tl.where(alive, NMIN, 0)
+            longer = alive
+            for j in range(NMIN, NMAX):
+                s_j = tl.load(
+                    base + end_of_suffix - j, mask=(end_of_suffix - j) >= 0, other=-2
+                )
+                t_j = tl.load(base + e - j, mask=longer & ((e - j) >= 0), other=-1)
+                longer = longer & (t_j == s_j)
+                match = tl.where(longer, match + 1, match)
+            score = tl.where(alive, match.to(tl.int64) * SCORE_STRIDE + e.to(tl.int64), -1)
+            best = tl.maximum(best, tl.max(score, axis=0))
+    if best < 0:
+        return
+    end = (best % SCORE_STRIDE).to(tl.int32)
+    # A match close to the suffix has fewer than K tokens after it.
+    valid = tl.minimum(K, end_of_suffix - end)
+    idx = tl.arange(0, BLOCK_K)
+    toks = tl.load(base + end + 1 + idx, mask=idx < valid, other=0)
+    tl.store(out_tokens_ptr + req * K + idx, toks, mask=idx < K)
+    tl.store(out_len_ptr + req, (best // SCORE_STRIDE).to(tl.int32))
+    tl.store(out_valid_ptr + req, valid)
+
+
+@triton.jit
+def _fuse_kernel(
+    draft_ptr,
+    draft_stride,
+    look_ptr,
+    len_ptr,
+    valid_ptr,
+    use_ptr,
+    idx_mapping_ptr,
+    idx_mapping_stride,
+    cache_ptr,
+    cache_stride_row,
+    cache_stride_step,
+    nmin,
+    nstrong,
+    agree_min,
+    vocab,
+    K: tl.constexpr,
+    BLOCK_K: tl.constexpr,
+    BLOCK_V: tl.constexpr,
+    HAS_CACHE: tl.constexpr,
+):
+    """Fuse, then rewrite the draft-logits rows of the taken positions to a point mass.
+    Grid (requests, K): program (r, 0) decides, every program rewrites its own step."""
+    req = tl.program_id(0)
+    step = tl.program_id(1)
+    req_state = tl.load(idx_mapping_ptr + req * idx_mapping_stride)
+    if req_state < 0:
+        return
+    idx = tl.arange(0, BLOCK_K)
+    kmask = idx < K
+    match_len = tl.load(len_ptr + req)
+    valid = tl.load(valid_ptr + req)
+    drafted = tl.load(draft_ptr + req * draft_stride + idx, mask=kmask, other=0)
+    looked = tl.load(look_ptr + req * K + idx, mask=kmask, other=0).to(tl.int64)
+    disagree = (drafted != looked) & (idx < valid) & kmask
+    # Positions the match did not supply are not agreement.
+    agree = tl.minimum(tl.min(tl.where(disagree, idx, K)), valid)
+    take = (match_len >= nstrong) | ((match_len >= nmin) & (agree >= agree_min))
+    # Every program of the request computes the same decision; each writes its own step.
+    if take & (step < valid):
+        token = tl.load(look_ptr + req * K + step).to(tl.int64)
+        tl.store(draft_ptr + req * draft_stride + step, token)
+        if HAS_CACHE:
+            row = cache_ptr + req_state.to(tl.int64) * cache_stride_row + step * cache_stride_step
+            for v0 in range(0, vocab, BLOCK_V):
+                offs = v0 + tl.arange(0, BLOCK_V)
+                tl.store(row + offs, float("-inf"), mask=offs < vocab)
+            tl.store(row + token, 0.0)
+    if step == 0:
+        tl.store(use_ptr + req, (take & (valid > 0)).to(tl.int32))
+
+
+class ContextLookup:
+    """Persistent buffers for one speculator (CUDA-graph safe: no host reads)."""
+
+    def __init__(self, max_num_reqs: int, k: int, device: torch.device,
+                 nmin: int = 6, nstrong: int = 8, agree_min: int = 2, nmax: int = 32,
+                 search_max: int = 1 << 30):
+        self.k, self.nmin, self.nstrong, self.agree_min = k, nmin, nstrong, agree_min
+        self.nmax, self.search_max = nmax, search_max
+        self.tokens = torch.zeros(max_num_reqs, k, dtype=torch.int32, device=device)
+        self.match_len = torch.zeros(max_num_reqs, dtype=torch.int32, device=device)
+        self.valid = torch.zeros(max_num_reqs, dtype=torch.int32, device=device)
+        # Per request: 1 when this step's drafts came from the lookup (for stats).
+        self.used = torch.zeros(max_num_reqs, dtype=torch.int32, device=device)
+
+    def apply(self, token_history: torch.Tensor, total_len: torch.Tensor,
+              idx_mapping: torch.Tensor, idx_mapping_stride: int, num_reqs: int,
+              draft_tokens: torch.Tensor, draft_logits: torch.Tensor | None) -> None:
+        """`draft_tokens[:num_reqs]` <- the fused proposal; `draft_logits` (the
+        [rows, K, vocab] cache indexed by request state) <- point masses where taken."""
+        _suffix_lookup_kernel[(num_reqs,)](
+            token_history, token_history.stride(0), total_len, idx_mapping,
+            idx_mapping_stride, self.tokens, self.match_len, self.valid, self.search_max,
+            K=self.k, NMAX=self.nmax, NMIN=min(self.nmin, 4), BLOCK=1024,
+            BLOCK_K=triton.next_power_of_2(self.k), num_warps=4,
+        )
+        cache = draft_logits if draft_logits is not None else draft_tokens
+        _fuse_kernel[(num_reqs, self.k)](
+            draft_tokens, draft_tokens.stride(0), self.tokens, self.match_len, self.valid,
+            self.used, idx_mapping, idx_mapping_stride, cache,
+            cache.stride(0), cache.stride(1) if cache.dim() > 1 else 0,
+            self.nmin, self.nstrong, self.agree_min,
+            cache.shape[-1] if draft_logits is not None else 0,
+            K=self.k, BLOCK_K=triton.next_power_of_2(self.k), BLOCK_V=4096,
+            HAS_CACHE=draft_logits is not None, num_warps=4,
+        )
