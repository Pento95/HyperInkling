@@ -570,3 +576,36 @@ def validate_xgrammar_grammar(sampling_params: SamplingParams) -> None:
         "XGrammar structured outputs backend "
         "does not support this structured outputs specification"
     )
+
+
+def _without_json_whitespace(tag: "xgr.StructuralTag") -> "xgr.StructuralTag":
+    """Forbid whitespace in the JSON values of a structural tag: each JSON-style node
+    becomes the grammar the JSON paths compile. Whitespace inside string values is
+    unchanged; other styles (XML tool calls) are left alone. From vllm#68990 (only the
+    server-wide flag; nodes with `excludes` keep their schema, a grammar cannot)."""
+    # Imported here, as xgrammar is loaded lazily.
+    from pydantic import BaseModel
+    from xgrammar.structural_tag import GrammarFormat, JSONSchemaFormat
+
+    def convert(node: Any) -> Any:
+        if (
+            isinstance(node, JSONSchemaFormat)
+            and node.style == "json"
+            and not node.excludes
+        ):
+            grammar = xgr.Grammar.from_json_schema(
+                json.dumps(node.json_schema),
+                any_whitespace=False,
+                separators=(",", ":"),
+                any_order=node.any_order,
+            )
+            return GrammarFormat(grammar=str(grammar))
+        if isinstance(node, BaseModel):
+            for name in type(node).model_fields:
+                setattr(node, name, convert(getattr(node, name)))
+        elif isinstance(node, list):
+            return [convert(item) for item in node]
+        return node
+
+    tag.format = convert(tag.format)
+    return tag
