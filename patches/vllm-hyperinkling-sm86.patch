diff --git a/vllm/models/inkling2/nvidia/ops/lookup.py b/vllm/models/inkling2/nvidia/ops/lookup.py
new file mode 100644
index 0000000000..f1c8baf1b2
--- /dev/null
+++ b/vllm/models/inkling2/nvidia/ops/lookup.py
@@ -0,0 +1,284 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Drafting from the request's own context (HYPERINKLING_LOOKUP=1).
+
+The DSpark drafter sees a 1024-token window; a document the answer quotes can be
+far beyond it. One Triton program per request finds the most recent occurrence of
+the longest suffix (up to NMAX tokens) of the token history; a match of `nmin`
+tokens or more replaces the drafts with the tokens that followed it.
+
+Lossless: every position taken from the lookup gets a point mass on the proposed
+token in the draft-logits cache, a legal q for the rejection sampler (acceptance
+becomes p(x)). Whether to take it must depend on the history only, never on the
+sampled drafts: choosing after seeing them leaves drafts that no longer follow
+their q, and the output no longer follows p.
+
+After HyperQwen's dflash2-lookup-drafting (syv-ai/HyperQwen, Apache-2.0).
+"""
+
+import torch
+
+from vllm.triton_utils import tl, triton
+
+# "Longest match, then most recent" as one max over len * SCORE_STRIDE + end index.
+SCORE_STRIDE = tl.constexpr(1 << 32)
+
+
+@triton.jit
+def _suffix_lookup_kernel(
+    tokens_ptr,
+    tokens_stride,
+    total_len_ptr,
+    idx_mapping_ptr,
+    idx_mapping_stride,
+    out_tokens_ptr,
+    out_len_ptr,
+    out_valid_ptr,
+    search_max,
+    K: tl.constexpr,
+    NMAX: tl.constexpr,
+    NMIN: tl.constexpr,
+    BLOCK: tl.constexpr,
+    BLOCK_K: tl.constexpr,
+):
+    req = tl.program_id(0)
+    tl.store(out_len_ptr + req, 0)
+    tl.store(out_valid_ptr + req, 0)
+    req_state = tl.load(idx_mapping_ptr + req * idx_mapping_stride)
+    if req_state < 0:
+        return
+    total_len = tl.load(total_len_ptr + req_state)
+    if total_len < NMIN + 2:
+        return
+    base = tokens_ptr + req_state.to(tl.int64) * tokens_stride
+    end_of_suffix = total_len - 1
+    # Candidate ends before the suffix's own end; a candidate may overlap the suffix, so
+    # a repeating pattern (a list marker, an indent) is proposed from its own period.
+    hi = end_of_suffix
+    lo = tl.maximum(NMIN - 1, total_len - search_max)
+    best = tl.full([], -1, tl.int64)
+    for start in range(lo, hi, BLOCK):
+        e = start + tl.arange(0, BLOCK)
+        alive = (e < hi) & (e >= lo)
+        # The NMIN-token prefix first: most blocks die here.
+        for j in range(NMIN):
+            s_j = tl.load(base + end_of_suffix - j)
+            t_j = tl.load(base + e - j, mask=alive & ((e - j) >= 0), other=-1)
+            alive = alive & (t_j == s_j)
+        if tl.max(alive.to(tl.int32)) > 0:
+            match = tl.where(alive, NMIN, 0)
+            longer = alive
+            for j in range(NMIN, NMAX):
+                s_j = tl.load(
+                    base + end_of_suffix - j, mask=(end_of_suffix - j) >= 0, other=-2
+                )
+                t_j = tl.load(base + e - j, mask=longer & ((e - j) >= 0), other=-1)
+                longer = longer & (t_j == s_j)
+                match = tl.where(longer, match + 1, match)
+            score = tl.where(
+                alive, match.to(tl.int64) * SCORE_STRIDE + e.to(tl.int64), -1
+            )
+            best = tl.maximum(best, tl.max(score, axis=0))
+    if best < 0:
+        return
+    end = (best % SCORE_STRIDE).to(tl.int32)
+    # A match close to the suffix has fewer than K tokens after it.
+    valid = tl.minimum(K, end_of_suffix - end)
+    idx = tl.arange(0, BLOCK_K)
+    toks = tl.load(base + end + 1 + idx, mask=idx < valid, other=0)
+    tl.store(out_tokens_ptr + req * K + idx, toks, mask=idx < K)
+    tl.store(out_len_ptr + req, (best // SCORE_STRIDE).to(tl.int32))
+    tl.store(out_valid_ptr + req, valid)
+
+
+@triton.jit
+def _fuse_kernel(
+    draft_ptr,
+    draft_stride,
+    look_ptr,
+    len_ptr,
+    valid_ptr,
+    used_ptr,
+    idx_mapping_ptr,
+    idx_mapping_stride,
+    nmin,
+    K: tl.constexpr,
+    BLOCK_K: tl.constexpr,
+):
+    """One program per request: decide, then write the taken positions. `used` holds how
+    many leading positions came from the lookup (0: none)."""
+    req = tl.program_id(0)
+    tl.store(used_ptr + req, 0)
+    req_state = tl.load(idx_mapping_ptr + req * idx_mapping_stride)
+    if req_state < 0:
+        return
+    idx = tl.arange(0, BLOCK_K)
+    kmask = idx < K
+    match_len = tl.load(len_ptr + req)
+    valid = tl.load(valid_ptr + req)
+    looked = tl.load(look_ptr + req * K + idx, mask=kmask, other=0).to(tl.int64)
+    if (match_len >= nmin) & (valid > 0):
+        tl.store(
+            draft_ptr + req * draft_stride + idx, looked, mask=kmask & (idx < valid)
+        )
+        tl.store(used_ptr + req, valid)
+
+
+@triton.jit
+def _point_mass_kernel(
+    draft_ptr,
+    draft_stride,
+    used_ptr,
+    idx_mapping_ptr,
+    idx_mapping_stride,
+    cache_ptr,
+    cache_stride_row,
+    cache_stride_step,
+    vocab,
+    BLOCK_V: tl.constexpr,
+):
+    """Grid (requests, K): the draft-logits row of each taken position becomes a
+    point mass on the token now in `draft_tokens`."""
+    req = tl.program_id(0)
+    step = tl.program_id(1)
+    req_state = tl.load(idx_mapping_ptr + req * idx_mapping_stride)
+    if (req_state < 0) | (step >= tl.load(used_ptr + req)):
+        return
+    token = tl.load(draft_ptr + req * draft_stride + step)
+    row = (
+        cache_ptr + req_state.to(tl.int64) * cache_stride_row + step * cache_stride_step
+    )
+    for v0 in range(0, vocab, BLOCK_V):
+        offs = v0 + tl.arange(0, BLOCK_V)
+        tl.store(row + offs, float("-inf"), mask=offs < vocab)
+    tl.store(row + token, 0.0)
+
+
+@triton.jit
+def _claim_candidates_kernel(
+    draft_ptr,
+    draft_stride,
+    used_ptr,
+    idx_mapping_ptr,
+    idx_mapping_stride,
+    cached_ptr,
+    num_steps,
+    top_k,
+    BLOCK_K: tl.constexpr,
+):
+    """Grid (requests, K): a sparse draft-logits cache (DFlash2's, which clears
+    only the candidates it wrote last) records each point mass's token as its
+    candidates, so the next step clears it."""
+    req = tl.program_id(0)
+    step = tl.program_id(1)
+    req_state = tl.load(idx_mapping_ptr + req * idx_mapping_stride)
+    if (req_state < 0) | (step >= tl.load(used_ptr + req)):
+        return
+    token = tl.load(draft_ptr + req * draft_stride + step).to(tl.int64)
+    offs = tl.arange(0, BLOCK_K)
+    base = (req_state.to(tl.int64) * num_steps + step) * top_k
+    tokens = tl.zeros_like(offs).to(tl.int64) + token
+    tl.store(cached_ptr + base + offs, tokens, mask=offs < top_k)
+
+
+class ContextLookup:
+    """Persistent buffers for one speculator (CUDA-graph safe: no host reads)."""
+
+    def __init__(
+        self,
+        max_num_reqs: int,
+        k: int,
+        device: torch.device,
+        nmin: int = 8,
+        nmax: int = 32,
+        search_max: int = 1 << 30,
+    ):
+        self.k, self.nmin = k, nmin
+        self.nmax, self.search_max = nmax, search_max
+        self.tokens = torch.zeros(max_num_reqs, k, dtype=torch.int32, device=device)
+        self.match_len = torch.zeros(max_num_reqs, dtype=torch.int32, device=device)
+        self.valid = torch.zeros(max_num_reqs, dtype=torch.int32, device=device)
+        # Per request: how many leading drafts came from the lookup this step.
+        self.used = torch.zeros(max_num_reqs, dtype=torch.int32, device=device)
+
+    def apply(
+        self,
+        token_history: torch.Tensor,
+        total_len: torch.Tensor,
+        idx_mapping: torch.Tensor,
+        idx_mapping_stride: int,
+        num_reqs: int,
+        draft_tokens: torch.Tensor,
+        draft_logits: torch.Tensor | None,
+    ) -> None:
+        """`draft_tokens[:num_reqs]` <- the fused proposal; `draft_logits` (the
+        [rows, K, vocab] cache indexed by request state) <- point masses where taken."""
+        _suffix_lookup_kernel[(num_reqs,)](
+            token_history,
+            token_history.stride(0),
+            total_len,
+            idx_mapping,
+            idx_mapping_stride,
+            self.tokens,
+            self.match_len,
+            self.valid,
+            self.search_max,
+            K=self.k,
+            NMAX=self.nmax,
+            NMIN=min(self.nmin, 4),
+            BLOCK=1024,
+            BLOCK_K=triton.next_power_of_2(self.k),
+            num_warps=4,
+        )
+        _fuse_kernel[(num_reqs,)](
+            draft_tokens,
+            draft_tokens.stride(0),
+            self.tokens,
+            self.match_len,
+            self.valid,
+            self.used,
+            idx_mapping,
+            idx_mapping_stride,
+            self.nmin,
+            K=self.k,
+            BLOCK_K=triton.next_power_of_2(self.k),
+            num_warps=1,
+        )
+        if draft_logits is not None:
+            _point_mass_kernel[(num_reqs, self.k)](
+                draft_tokens,
+                draft_tokens.stride(0),
+                self.used,
+                idx_mapping,
+                idx_mapping_stride,
+                draft_logits,
+                draft_logits.stride(0),
+                draft_logits.stride(1),
+                draft_logits.shape[-1],
+                BLOCK_V=4096,
+                num_warps=4,
+            )
+
+    def claim_candidates(
+        self,
+        draft_tokens: torch.Tensor,
+        idx_mapping: torch.Tensor,
+        idx_mapping_stride: int,
+        num_reqs: int,
+        cached_candidate_ids: torch.Tensor,
+    ) -> None:
+        """After `apply`, for a cache that clears only its last candidates
+        (`cached_candidate_ids [rows, K, top_k]`)."""
+        top_k = cached_candidate_ids.shape[-1]
+        _claim_candidates_kernel[(num_reqs, self.k)](
+            draft_tokens,
+            draft_tokens.stride(0),
+            self.used,
+            idx_mapping,
+            idx_mapping_stride,
+            cached_candidate_ids,
+            self.k,
+            top_k,
+            BLOCK_K=triton.next_power_of_2(top_k),
+            num_warps=1,
+        )
diff --git a/vllm/models/inkling2/nvidia/ops/moe_marlin.py b/vllm/models/inkling2/nvidia/ops/moe_marlin.py
new file mode 100644
index 0000000000..f25fa1f5a6
--- /dev/null
+++ b/vllm/models/inkling2/nvidia/ops/moe_marlin.py
@@ -0,0 +1,272 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Inkling2 routed experts on Ampere (SM8x): Marlin MoE GEMMs (bf16
+activations, weights dequantized in the kernel) in place of Hopper's Humming
+ones. SM8x has neither FP4 nor FP8 tensor cores, so the activations stay in
+bf16, as on Hopper.
+
+Weights are the checkpoint's NVFP4 / MXFP8 experts, or HyperInkling's INT4
+(AWQ layout: asymmetric, group 128, `uint4` with zero points).
+
+The interface and row order are `moe_sm90.HummingExperts`': rows stay in
+the flat (token * topk + slot) order, the gate/up GEMM gathers each row's
+token, `moe_sm90.swiglu` applies the softcapped SiTU and the routing
+weight, and the down GEMM writes row by row for `ops.moe.combine`.
+"""
+
+import math
+import os
+from types import SimpleNamespace
+from typing import Literal
+
+import torch
+
+import vllm._custom_ops as ops
+from vllm.model_executor.layers.fused_moe.moe_align_block_size import (
+    moe_align_block_size,
+)
+from vllm.model_executor.layers.quantization.utils.marlin_utils import (
+    get_marlin_workspace,
+    marlin_moe_intermediate_size,
+    marlin_moe_permute_scales,
+    moe_awq_to_marlin_zero_points,
+)
+from vllm.model_executor.layers.quantization.utils.marlin_utils_fp4 import (
+    prepare_nvfp4_moe_layer_for_marlin,
+)
+from vllm.model_executor.layers.quantization.utils.marlin_utils_fp8 import (
+    prepare_mxfp8_moe_layer_for_marlin,
+)
+from vllm.scalar_type import scalar_types
+from vllm.triton_utils import tl, triton
+
+from .moe_sm90 import swiglu
+
+ExpertFormat = Literal["nvfp4", "mxfp8", "int4"]
+INT4_GROUP = 128
+# `moe_align_block_size` places an expert's rows in atomic order, different at every
+# call. A row's result depends on its Marlin block, so the rows go in ascending order.
+_MOE_ORDER = os.environ.get("HYPERINKLING_MOE_ORDER", "1") == "1"
+
+
+@triton.jit
+def _order_rows_kernel(
+    Ids,
+    SortedIds,
+    ExpertIds,
+    NumPadded,
+    n,
+    block_m,
+    max_blocks,
+    BLOCK: tl.constexpr,
+):
+    """One program per expert: its rows of `SortedIds`, rewritten in ascending order
+    (their places are known from the expert's first block)."""
+    expert = tl.program_id(0)
+    num_blocks = tl.load(NumPadded) // block_m
+    none = 0x7FFFFFFF
+    first = none
+    for b0 in range(0, max_blocks, BLOCK):
+        b = b0 + tl.arange(0, BLOCK)
+        e = tl.load(ExpertIds + b, b < num_blocks, other=-1)
+        first = tl.minimum(first, tl.min(tl.where(e == expert, b, none)))
+    if first == none:
+        return
+    place = first * block_m
+    for i0 in range(0, n, BLOCK):
+        i = i0 + tl.arange(0, BLOCK)
+        mine = (tl.load(Ids + i, i < n, other=-1) == expert).to(tl.int32)
+        rank = tl.cumsum(mine, 0) - 1
+        tl.store(SortedIds + place + rank, i, mine != 0)
+        place += tl.sum(mine)
+
+
+def order_rows(
+    ids: torch.Tensor,
+    sorted_ids: torch.Tensor,
+    expert_ids: torch.Tensor,
+    num_tokens_padded: torch.Tensor,
